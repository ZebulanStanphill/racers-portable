<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp uap5 rescap">
  <!-- The build fills in the version; see CMakeLists.txt. -->
  <Identity Name="org.isledecomp.racers" Publisher="CN=Racers Portable" Version="@UWP_PACKAGE_VERSION@" />
  <!-- MSBuild requires this, even for apps that never run on a phone. -->
  <mp:PhoneIdentity PhoneProductId="85C3DBBB-3FEC-4073-A69B-8F8FE3B32B7D" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>LEGO® Racers</DisplayName>
    <PublisherDisplayName>ZebulanStanphill/racers-portable</PublisherDisplayName>
    <Logo>StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application
      Id="App"
      Executable="LEGORacers.exe"
      EntryPoint="LEGORacers.App">
      <uap:VisualElements
        DisplayName="LEGO® Racers"
        Description="LEGO® Racers Xbox One/Series X|S port"
        BackgroundColor="transparent"
        Square150x150Logo="Square150x150Logo.png"
        Square44x44Logo="Square44x44Logo.png">
        <uap:SplashScreen Image="SplashScreen.png" uap5:Optional="true" BackgroundColor="black" />
        <uap:DefaultTile
          ShortName="LEGO® Racers"
          Wide310x150Logo="Wide310x150Logo.png"
          Square310x310Logo="LargeTile.png"
          Square71x71Logo="Square71x71Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!-- Game Mode resources on Xbox (more CPU and memory). -->
    <rescap:Capability Name="expandedResources" />
    <!-- Read the game data and write logs outside the app's own folders. -->
    <rescap:Capability Name="broadFileSystemAccess" />
    <uap:Capability Name="removableStorage" />
  </Capabilities>
</Package>
